def average_scores(scores):
    averages = []  # list to store average for each student
    
    for student_scores in scores:
        total = 0
        count = len(student_scores)
        
        for grade, lateness in student_scores:
            # Apply lateness penalty
            if lateness == 0:
                penalty = 1.0
            elif lateness == 1:
                penalty = 0.9
            elif lateness == 2:
                penalty = 0.75
            elif lateness == 3:
                penalty = 0.5
            else:
                penalty = 0.0
                
            total += grade * penalty
        
        # Calculate average for this student
        average = total / count
        averages.append(average)
    
    return averages
