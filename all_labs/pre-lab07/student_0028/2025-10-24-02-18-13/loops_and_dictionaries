def pyramid(n):
    for i in range(n, 0, -1):
        for j in range(i, 0, -1):
            print(j, end=" ")
        print()

def merge_dicts(d1, d2):
    result = d1.copy()
    for k in d2:
        if k in result:
            result[k] = result[k] + d2[k]
        else:
            result[k] = d2[k]
    return result